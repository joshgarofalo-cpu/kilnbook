# Copy this file to .env.local and fill in both values.
# Find them in Supabase: Project Settings -> API Keys (and Data API for the URL).
# The publishable key (starts sb_publishable_, or the older "anon" key) is safe to ship in the app;
# the security rules in supabase/schema.sql are what protect the data.
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx
